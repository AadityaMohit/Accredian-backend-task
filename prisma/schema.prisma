generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = "mysql://root:12345@localhost:3306/referralDB"
}

model Referral {
  id           Int    @id @default(autoincrement())
  name         String
  email        String
  refereeName  String
  refereeEmail String
  course       String
  createdAt    DateTime @default(now())
}
